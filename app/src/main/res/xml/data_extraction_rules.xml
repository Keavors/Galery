<?xml version="1.0" encoding="utf-8"?>
<!--
    What leaves the device in a cloud backup or a device-to-device transfer.

    Only the settings store is listed. Naming anything at all makes the rest
    opt-out by construction, which is exactly what the hidden vault needs: those
    files were deliberately moved out of shared storage, and copying them into a
    backup would undo the point of hiding them.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
