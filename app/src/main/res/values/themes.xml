<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose paints everything; this theme only controls the window before the
        first frame. Keeping the window background transparent avoids a flash of
        the wrong colour when the app opens straight into the dark viewer.
    -->
    <style name="Theme.Gallery" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
